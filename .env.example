# Copy to `.env.local` and fill in real values (never commit `.env.local`).

# Neon Postgres
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Admin panel password
ADMIN_PASSWORD=

# Vercel Blob (run `vercel env pull` after creating a Blob store in Vercel dashboard)
BLOB_READ_WRITE_TOKEN=

# OpenAI — admin "Auto-fill", "Prompt generator", "Polish content"
OPENAI_API_KEY=sk-mock-replace-with-your-openai-key
# OPENAI_MODEL=gpt-4o-mini

# Giphy (optional, for comment GIF picker)
NEXT_PUBLIC_GIPHY_API_KEY=
