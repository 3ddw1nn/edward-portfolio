# Copy to `.env.local` and fill in real values (never commit `.env.local`).

# Neon Postgres
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Admin panel password
ADMIN_PASSWORD=

# Cloudflare R2 (image uploads)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=blog-images
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# OpenAI — admin "Auto-fill", "Prompt generator", "Polish content"
OPENAI_API_KEY=sk-mock-replace-with-your-openai-key
# OPENAI_MODEL=gpt-4o-mini

# Giphy (optional, for comment GIF picker)
NEXT_PUBLIC_GIPHY_API_KEY=
