# Copy to `.env.local` and fill in real values (never commit `.env.local`).

# Site + Supabase (existing)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# ADMIN_PASSWORD=

# OpenAI — admin “Auto-fill”, “Prompt generator”, “Polish content” (`/api/admin/ai`)
# Replace with a real secret from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-mock-replace-with-your-openai-key
# Optional model override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
